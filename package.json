{
  "name": "ubume",
  "version": "0.1.18",
  "description": "Terminal UI for Ubume \u2014 TypeScript + Bun + Ink",
  "type": "module",
  "bin": {
    "ubume": "bin/ubume.js"
  },
  "scripts": {
    "start": "bun run --silent src/index.tsx",
    "dev": "bun --watch --silent src/index.tsx",
    "dev:run": "node scripts/development/run-local-dev.mjs",
    "install:dev-bin": "node scripts/development/install-dev-shims.mjs",
    "debug:claude-models": "bun run --silent scripts/providers/debug-claude-model-discovery.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "check": "biome ci src",
    "test": "bun test --max-concurrency=1",
    "audit:ubume-gap": "node scripts/maintenance/audit-capabilities.mjs",
    "smoke:terminal-bench": "node scripts/providers/smoke-headless-exec.mjs",
    "gen-build-info": "node scripts/build/generate-build-info.mjs",
    "build": "bun run gen-build-info && bun run typecheck && bun run typecheck:utilities && bun run check",
    "prepublishOnly": "npm run sync:npm-lock && npm run gen-build-info && npm run typecheck && npm run typecheck:utilities && npm run check && bun test --max-concurrency=1",
    "sync:npm-lock": "bun scripts/release/sync-npm-lock.ts",
    "typecheck:utilities": "tsc --noEmit -p scripts/tsconfig.json",
    "bench:startup": "bun scripts/bench/startup.ts",
    "bench:interactive": "python3 scripts/bench/interactive-startup.py",
    "bench:stream": "bun scripts/bench/stream.ts",
    "bench:workspace": "bun scripts/bench/workspace.ts",
    "bench:render": "bun scripts/bench/render.ts",
    "bench:startup-timeline": "python3 scripts/bench/startup-timeline.py",
    "bench:update-startup": "python3 scripts/bench/update-startup.py",
    "bench:memory": "python3 scripts/bench/idle-memory.py",
    "bench:stream-e2e": "python3 scripts/bench/stream-e2e.py",
    "bench:shell": "bun scripts/bench/shell-output.ts",
    "bench:provider-switch": "bun scripts/bench/provider-switch.ts",
    "bench:all": "bun scripts/bench/all.ts",
    "bench:compare": "bun scripts/bench/compare.ts",
    "check:permissions": "python3 scripts/check-permission-pty.py",
    "check:pty": "python3 scripts/testing/check-terminal-pty.py",
    "check:resume": "python3 scripts/testing/check-resume-pty.py",
    "bench:resume": "bun scripts/bench/resume.ts",
    "check:e2e": "python3 scripts/testing/check-offline-workflow.py",
    "bench:resize": "python3 scripts/bench/resize.py",
    "check:resize": "python3 scripts/check-resize-pty.py"
  },
